# Django Configuration
SECRET_KEY=django-insecure-your-secret-key-change-in-production
DEBUG=True
DEBUG_PROPAGATE_EXCEPTIONS=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Leave empty for SQLite (default for local development)
# For PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=

# Frontend/Backend Communication
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional: Redis Configuration (for production use only)
# Commented out for local development - uses in-memory channels
# REDIS_URL=redis://localhost:6379/0

# Optional: Celery Configuration (for production use only)
# Commented out for local development
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
