# Copy to .env and fill in. Nothing here is a real credential.
#
#   cp .env.example .env
#
# Only SECRET_KEY is required to boot. Without an LLM key the AI features fall
# back to deterministic responses rather than failing.

# --- Django ------------------------------------------------------------------
# Generate with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
DEBUG_PROPAGATE_EXCEPTIONS=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# Empty means SQLite at db.sqlite3. For Postgres:
#   postgresql://user:password@localhost:5432/wealthplay
DATABASE_URL=

# --- Frontend origins --------------------------------------------------------
# The Vite dev server proxies /api, so these only matter when the SPA is served
# from a different origin than Django.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- LLM providers -----------------------------------------------------------
# Groq is the primary provider: free tier, sub-second responses.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_HEAVY=openai/gpt-oss-120b

# Gemini is the failover. Keep the model current — Google retires old ids and
# the API then returns 404 for every request.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Cache -------------------------------------------------------------------
# Empty means Django's in-process LocMem cache, which is fine for one worker.
# Point at Redis for multi-worker deployments so the market cache is shared.
REDIS_URL=

# Local model (Ollama). Primary provider: no key, no quota, nothing leaves the machine.
#   ollama pull qwen2.5:0.5b-instruct
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b-instruct
