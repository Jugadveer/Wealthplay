# Copy to .env and fill in. Nothing here is a real credential.
#
#   cp .env.example .env
#
# Only SECRET_KEY is required to boot. Everything else has a working default.
#
# Without any language model, the AI surfaces report themselves unavailable and
# the UI says so. They do not fall back to a template and label it AI. Most of
# the AI needs no model at all — the glossary, the content search, the portfolio
# review and the goal verdicts are computed — so the app stays useful either way.

# --- Django ------------------------------------------------------------------
# Generate with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
DEBUG_PROPAGATE_EXCEPTIONS=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# Empty means SQLite at db.sqlite3, which is fine locally.
#
# Required in production, and required absolutely on a serverless host: the
# filesystem there is per-invocation, so a SQLite file loses every write between
# requests. settings.py refuses to start rather than let that look like it works.
#
#   postgresql://user:password@host:5432/wealthplay
DATABASE_URL=

# --- Frontend origins --------------------------------------------------------
# The Vite dev server proxies /api, so these only matter when the SPA is served
# from a different origin than Django. On Vercel the deployment hostname is read
# from VERCEL_URL automatically, including for preview builds.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- HTTPS (production) ------------------------------------------------------
# Turning this on also makes the session and CSRF cookies secure-only, and
# enables HSTS for one hour. Raise SECURE_HSTS_SECONDS to 31536000 once the
# domain has been stable on HTTPS for a while — it cannot be taken back inside
# the window a browser has already cached.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=3600

# --- The local model ---------------------------------------------------------
# The primary provider. No key, no quota, and nothing about a user's income
# leaves the machine. Warm responses take under a second.
#
#   ollama pull qwen2.5:0.5b-instruct
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b-instruct

# --- Hosted models (failover) ------------------------------------------------
# Used when Ollama is not reachable, which is the case on every serverless host.
# Groq's free tier answers in about half a second: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_HEAVY=openai/gpt-oss-120b

# Gemini is the last failover. Keep the model id current — Google retires old
# ones and the API then returns 404 for every request, which is how this app
# ended up with no working provider at all.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Cache -------------------------------------------------------------------
# Empty means a database-backed cache, which needs `manage.py createcachetable`
# and is the right default on serverless, where an in-process cache is discarded
# between invocations. Point at Redis for multi-worker deployments so the market
# cache is shared rather than warmed once per worker.
REDIS_URL=

# --- Scheduled work ----------------------------------------------------------
# Protects /api/market/cron/warm/ on hosts with no Celery worker. Vercel sends
# it as `Authorization: Bearer $CRON_SECRET`. Unset, the endpoint refuses in
# production and allows in development, so it is never accidentally open.
CRON_SECRET=
