{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/((?!static/).*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/market/cron/warm/", "schedule": "0 2 * * *" }
  ],
  "headers": [
    {
      "source": "/static/react/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
